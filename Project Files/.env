# LegalEase local configuration
# Put your real Google Gemini API key on the line below.
GEMINI_API_KEY=
# Set GEMINI_MODEL=auto to automatically choose from models your API key can access.
# Current stable Gemini text models documented by Google include Gemini 3.8 Flash,
# 3.7 Flash, 3.6 Flash and 3.5 Flash. Account availability can vary.
GEMINI_MODEL=auto
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.8-flash

# false = use the real Gemini API. Set true only for offline UI/export testing.
DEMO_MODE=false

BACKEND_URL=http://127.0.0.1:8000
APP_NAME=LegalEase
APP_VERSION=1.1.0
